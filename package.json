{
  "name": "glockenfels",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/client",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build -w apps/client",
    "online": "npm run build && npm start",
    "start": "npm start -w apps/server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w packages/engine && npm run test -w apps/server && npm run test -w packages/kingdoms",
    "sim": "npm run sim -w packages/kingdoms --",
    "dev:kingdoms": "npm run dev -w apps/kingdoms",
    "build:kingdoms": "npm run build -w apps/kingdoms"
  }
}
